# ---- Supabase -------------------------------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Server-only. Bypasses RLS — never expose to the client or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Client-visible copies (Vite inlines anything VITE_* into the bundle).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Anthropic ------------------------------------------------------------
# Server-only. This is the whole point of the proxy — it must never ship to a client.
ANTHROPIC_API_KEY=sk-ant-...
# Cost/quality dial for the assistant: low | medium | high | xhigh | max
ASSISTANT_EFFORT=medium

# ---- Stripe (web signups only; iOS/Mac must use StoreKit) -----------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_PRO=price_...

PUBLIC_URL=https://squirrel.app
