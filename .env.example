# Nothing here is needed to deploy the web app. The assistant runs in the
# browser with no model, no key, and no network, so the site works with this
# file empty. These are for accounts, sync, calendars, and billing.

# ---- Supabase -------------------------------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Server-only. Bypasses RLS — never expose to the client or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Client-visible copies (Vite inlines anything VITE_* into the bundle).
# Setting these two is what turns on sign-in and cross-device sync. Leave them
# unset and the app stays local-only, which is exactly the free tier.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Google Calendar ------------------------------------------------------
# From a Google Cloud project with the Calendar API enabled. The client secret
# is server-only: it exchanges the OAuth code for a refresh token, and a
# refresh token in a browser is a permanent grant on someone's whole calendar.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Must match an authorised redirect URI in the Cloud console exactly.
GOOGLE_REDIRECT_URI=https://squirrel.app/api/google/callback
# Where Google posts push notifications. HTTPS on a verified domain only.
GOOGLE_WEBHOOK_URL=https://squirrel.app/api/google/webhook

# Signs the OAuth `state` parameter — the only thing carrying the user's
# identity across Google's redirect, since that arrives as a plain navigation
# with no Authorization header. Unsigned, anyone could call the callback with
# someone else's user id and staple their own calendar onto that account.
# Defaults to the service-role key when unset, so there is one fewer thing to
# forget; set it to any long random string to keep them separate.
OAUTH_STATE_SECRET=

# Apple Calendar takes no key here, and cannot: there is no server-side Apple
# Calendar API. It works through EventKit inside the native app, on the user's
# own device. See DEPLOY.md.

# ---- Stripe (web signups only; iOS/Mac must use StoreKit) -----------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_PRO=price_...

PUBLIC_URL=https://squirrel.app

# ---- Email invites (Resend) -----------------------------------------------
RESEND_API_KEY=re_...
# Must be a verified sending domain in Resend.
INVITE_FROM=invites@squirrel.app

# ---- Model fallback (optional) ---------------------------------------------
# The only thing in Squirrel that costs money per message. Leave both unset and
# the assistant is entirely deterministic: no network call, no per-message cost,
# works offline. With a key set, a user can turn on Settings → Fallback and
# messages the rules *miss* — only those — get rewritten by a model and then run
# down the ordinary path.
#
# Server-side only. A VITE_ prefix would ship the key in the browser bundle.
ANTHROPIC_API_KEY=sk-ant-...
# Haiku by default: this is short-sentence translation over a fixed vocabulary.
# claude-sonnet-5 and claude-opus-4-8 also work — see DEPLOY.md for the maths.
ANTHROPIC_MODEL=claude-haiku-4-5
